{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "local: debug start",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile", "-File", "${workspaceFolder}/../start.ps1", "-Action", "Start", "-NoBrowser", "-EnableBackendDebug"
      ],
      "options": {
        "cwd": "${workspaceFolder}/.."
      },
      "problemMatcher": [
        "$javac"
      ],
      "group": "build"
    }
  ]
}
