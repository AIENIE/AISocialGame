# Copy to env.local, replace every placeholder, then run `chmod 600 env.local`.
# Never commit env.local. ENV=local may use AUTH_MODE=password or AUTH_MODE=totp;
# test/production environments must use AUTH_MODE=totp.
ENV=local
APP_ENV=local
SPRING_PROFILES_ACTIVE=local
AIENIE_RUNTIME_PLANE=windows-local
AUTH_MODE=totp
APP_ADMIN_COOKIE_SECURE=true
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD_HASH=<bcrypt-hash>
ADMIN_TOTP_ENCRYPTION_KEYS=v1:<base64-encoded-32-byte-key>
ADMIN_TOTP_ACTIVE_KEY_VERSION=v1

# Windows local shared-data target is resolved from the system matrix.
SPRING_DATASOURCE_URL=jdbc:mysql://localbase.testhut.top:23306/aisocialgame?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&connectTimeout=10000&socketTimeout=30000
SPRING_DATASOURCE_USERNAME=aisocialgame
SPRING_DATASOURCE_PASSWORD=<database-password>
SPRING_DATA_REDIS_HOST=localbase.testhut.top
SPRING_DATA_REDIS_PORT=26379
QDRANT_HOST=http://localbase.testhut.top
QDRANT_PORT=26333

SSO_USER_SERVICE_BASE_URL=https://localuserservice.testhut.top
SSO_CALLBACK_URL=https://localsocialgame.testhut.top/sso/callback
USER_GRPC_ADDR=static://localuserservice.testhut.top:22001
BILLING_GRPC_ADDR=static://localpayservice.testhut.top:22021
AI_GRPC_ADDR=static://localaiservice.testhut.top:22011
# Windows local launchers inject scripts/windows/local-trust/localcert-root-ca.crt
# as the gRPC TLS trust root for all three service clients.
USER_GRPC_NEGOTIATION_TYPE=TLS
BILLING_GRPC_NEGOTIATION_TYPE=TLS
AI_GRPC_NEGOTIATION_TYPE=TLS

APP_EXTERNAL_GRPC_AUTH_REQUIRED=true
APP_EXTERNAL_USERSERVICE_JWT_CALLER_ID=aisocialgame
APP_EXTERNAL_USERSERVICE_JWT_ISSUER=aisocialgame
APP_EXTERNAL_USERSERVICE_JWT_SECRET=<user-service-caller-secret-at-least-32-bytes>
APP_EXTERNAL_USERSERVICE_JWT_AUDIENCE=aienie-userservice-grpc
APP_EXTERNAL_USERSERVICE_JWT_TTL_SECONDS=300
APP_EXTERNAL_USERSERVICE_JWT_SCOPES=user.auth.session.read,user.directory.read,user.ban.read,user.ban.write
APP_EXTERNAL_PAYSERVICE_JWT=<pay-service-jwt>
APP_EXTERNAL_AISERVICE_HMAC_CALLER=<ai-service-caller-id>
APP_EXTERNAL_AISERVICE_HMAC_SECRET=<ai-service-hmac-secret>
